PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/calisthenics-tracker
USE_MEMORY_DB=false
# Required in production: use a strong random secret (32+ chars)
JWT_SECRET=replace-with-strong-random-string-min-32-chars
MONGO_CONNECT_RETRIES=12
MONGO_RETRY_DELAY_MS=2500
# Required in production: set only your public domains, comma separated
CORS_ALLOWED_HOSTS=app.example.com,api.example.com
GARMIN_EMAIL=
GARMIN_PASSWORD=
SPORTS_PROJECT_ROOT=/home/guido/code/sports
# Optional: explicit goals file path (defaults to goals.yaml or goals.example.yaml under SPORTS_PROJECT_ROOT)
SPORTS_GOALS_FILE=
SPORTS_SYNC_PAGE_SIZE=100
SPORTS_SYNC_MAX_ACTIVITIES=2000
SPORTS_UPLOAD_MAX_MB=25
# Required in production: use a strong random secret (32+ chars), independent from JWT_SECRET
SPORTS_CREDENTIALS_SECRET=replace-with-second-strong-random-string-min-32-chars
# Optional extra env file (defaults to /sports/.env in Docker)
SPORTS_ENV_FILE=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Optional alias used by older sports setup; if AZURE_OPENAI_MODEL is empty this is used automatically.
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_OPENAI_API_VERSIONS=
AZURE_FOUNDRY_API_VERSION=2024-05-01-preview
AZURE_FOUNDRY_API_VERSIONS=2024-05-01-preview,2024-08-01-preview,2024-10-21,2025-04-14
